# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kotlin/Gradle build cache
.kotlin/
android/.kotlin/

# Per-machine Claude Code permissions. Tracking this caused a merge conflict
# once already: it holds absolute paths from whichever machine wrote it.
.claude/settings.local.json

# Screenshots and board audits captured while chasing a bug. Useful to whoever
# is holding the phones that day, meaningless to everyone else, and the images
# were the three largest files in the repository.
/debug/

.claude/
CLAUDE.md
superpowers/
.superpowers/

.vscode/
# Audacity writes these beside a project while it is open: transient SQLite
# journals, not the project itself.
*.aup3-shm
*.aup3-wal

# Real RevenueCat keys, passed in with --dart-define-from-file. The example
# beside it is tracked and shows the shape; this one is filled in per machine.
/env/revenuecat.json

# Figma mockups referenced while restyling screens — reference material for
# whoever is doing that work, not part of the app.
/MOCKUP SCREENSHOTS/

# Xcode's resolved Swift Package Manager pins, regenerated locally whenever it
# resolves the RevenueCat SPM dependency. No other iOS lockfile is tracked
# here, so this follows the same rule as .swiftpm/ above.
**/xcshareddata/swiftpm/
